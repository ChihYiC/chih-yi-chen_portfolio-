---
// src/layouts/BaseLayout.astro
import '../styles/global.css'; 

interface Props {
  title?: string;
}

const { title = "Chih Yi Chen | Integrated Marketer & UX Researcher" } = Astro.props;
// 直接在這裡取得 base
const base = import.meta.env.BASE_URL || "/"; 
const faviconPath = base + "images/favicon.png";
---


<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={faviconPath} />
    </head>
  
  <body class="bg-surface text-slate font-body antialiased min-h-screen flex flex-col">
    <header class="w-full bg-white shadow-sm sticky top-0 z-50">
      <nav class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center">
        
        <a href={base} class="flex items-center gap-3 group">
          <img 
            src={faviconPath} 
            alt="Logo" 
            class="w-10 h-10 rounded-full"
          />
          <span class="text-xl font-bold text-primary">Chih Yi Chen.</span>
        </a>
        <ul class="flex gap-8 text-sm font-heading font-semibold text-slate">
          <li><a href={base} class="hover:text-secondary">Home</a></li>
          <li><a href={base + 'about'} class="hover:text-secondary">About</a></li>
          <li><a href={base + 'portfolio'} class="hover:text-secondary">UX Portfolio</a></li>
          <li><a href={base + 'blog'} class="hover:text-secondary">Blog</a></li>
          <li><a href={base + 'contact'} class="hover:text-secondary">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main class="flex-grow max-w-5xl mx-auto px-6 py-16 w-full">
      <slot />
    </main>

    <footer class="w-full bg-white border-t border-slate/10 py-10">
      <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
        <p class="text-sm text-slate/60 font-heading">© {new Date().getFullYear()} Chih Yi (Sophie) Chen.</p>
        <div class="flex gap-6">
          <a href="mailto:chih.yi.chen0814@gmail.com" class="text-primary hover:text-secondary"><i class="fa-regular fa-envelope text-xl"></i></a>
          <a href="https://www.linkedin.com/in/chih-yi-chen0814" target="_blank" class="text-primary hover:text-secondary"><i class="fa-brands fa-linkedin-in text-xl"></i></a>
          <a href="https://github.com/ChihYiC?tab=repositories" target="_blank" class="text-primary hover:text-secondary"><i class="fa-brands fa-github text-xl"></i></a>
        </div>
      </div>
    </footer>
  </body>
</html>