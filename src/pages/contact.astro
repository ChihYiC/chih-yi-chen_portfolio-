---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL || "/";
---

<BaseLayout title="Contact Me | Chih Yi Chen">
  <div class="max-w-3xl mx-auto py-12 px-6">
    {/* 麵包屑導覽：保持全局導覽系統的一致性 */}
    <Breadcrumbs />

    <header class="mb-10 mt-6">
      <h1 class="text-4xl md:text-5xl font-bold text-primary mb-4 font-heading">Contact Me</h1>
      <p class="text-lg text-slate/70 font-body leading-relaxed">
        Have a question, a research collaboration idea, or just want to say hello? Please feel free to drop a message below!
      </p>
    </header>

    {/* 符合人機互動防錯與對比原則的表單區塊 */}
    <div class="bg-white rounded-2xl shadow-sm border border-slate/10 p-8 md:p-10">
      
      {/* 💡 技術提醒：
        請將 action 中的 "your-formspree-id" 替換成你在 Formspree (或其它服務) 申請的真實 ID。
        如果是部署在 Netlify，可以直接在 form 標籤加上 netlify 屬性。
      */}
      <form action="https://formspree.io/f/your-formspree-id" method="POST" class="space-y-6">
        
        {/* 姓名輸入欄 */}
        <div>
          <label for="name" class="block text-sm font-semibold text-slate mb-2 font-heading">
            Full Name <span class="text-secondary" aria-hidden="true">*</span>
          </label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            placeholder="John Doe"
            class="w-full px-4 py-3 rounded-xl border border-slate/20 font-body text-slate placeholder-slate/30 focus:outline-none focus:ring-2 focus:ring-secondary/45 focus:border-secondary transition-all"
          />
        </div>

        {/* 電子信箱輸入欄 */}
        <div>
          <label for="email" class="block text-sm font-semibold text-slate mb-2 font-heading">
            Email Address <span class="text-secondary" aria-hidden="true">*</span>
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="you@example.com"
            class="w-full px-4 py-3 rounded-xl border border-slate/20 font-body text-slate placeholder-slate/30 focus:outline-none focus:ring-2 focus:ring-secondary/45 focus:border-secondary transition-all"
          />
        </div>

        {/* 郵件主旨輸入欄 */}
        <div>
          <label for="subject" class="block text-sm font-semibold text-slate mb-2 font-heading">
            Subject <span class="text-secondary" aria-hidden="true">*</span>
          </label>
          <input 
            type="text" 
            id="subject" 
            name="subject" 
            required 
            placeholder="Collaboration / UX Project Inquiry"
            class="w-full px-4 py-3 rounded-xl border border-slate/20 font-body text-slate placeholder-slate/30 focus:outline-none focus:ring-2 focus:ring-secondary/45 focus:border-secondary transition-all"
          />
        </div>

        {/* 訊息內文輸入欄 */}
        <div>
          <label for="message" class="block text-sm font-semibold text-slate mb-2 font-heading">
            Your Message <span class="text-secondary" aria-hidden="true">*</span>
          </label>
          <textarea 
            id="message" 
            name="message" 
            rows="5" 
            required 
            placeholder="Tell me about your project, timeline, or ideas..."
            class="w-full px-4 py-3 rounded-xl border border-slate/20 font-body text-slate placeholder-slate/30 focus:outline-none focus:ring-2 focus:ring-secondary/45 focus:border-secondary transition-all resize-none"
          ></textarea>
        </div>

        {/* 提交按鈕：具備微互動反饋效果 */}
        <div class="pt-2">
          <button 
            type="submit" 
            class="w-full md:w-auto px-8 py-3.5 bg-primary text-white font-heading font-bold rounded-xl shadow-sm hover:bg-secondary hover:shadow-md active:scale-[0.98] transition-all duration-200 cursor-pointer text-center block"
          >
            Send Message →
          </button>
        </div>

      </form>
    </div>
  </div>
</BaseLayout>