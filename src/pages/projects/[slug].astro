---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${project.data.title} | Projects`}>
  <article class="max-w-4xl mx-auto py-12 px-6">
    <Breadcrumbs />
    
    <h1 class="text-4xl font-bold mb-6 text-primary">{project.data.title}</h1>
    
    {project.data.heroImage && (
      <img 
        src={base + project.data.heroImage.replace(/^\//, '')} 
        alt={project.data.title} 
        class="w-full h-auto rounded-xl mb-8 shadow-sm"
      />
    )}
    
    <div class="prose prose-lg max-w-none text-slate">
      <Content components={{ Callout }} />
    </div>
  </article>
</BaseLayout>