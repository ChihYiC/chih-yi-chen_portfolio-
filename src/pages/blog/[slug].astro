---
// src/pages/blog/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  return posts.map((post) => ({
    // ✨ 強制將網址轉為小寫，避免大小寫衝突
    params: { slug: post.id.toLowerCase() },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${post.data.title} | Blog`}>
  <article class="max-w-4xl mx-auto py-12 px-6">
    <Breadcrumbs />
    
    <h1 class="text-4xl font-bold mb-6 text-primary">{post.data.title}</h1>
    
    {post.data.heroImage && (
      <img 
        src={base + post.data.heroImage.replace(/^\//, '')} 
        alt={post.data.title} 
        class="w-full h-auto rounded-xl mb-8 shadow-sm"
      />
    )}
    
    <div class="prose prose-lg max-w-none text-slate">
      <Content components={{ Callout }} />
    </div>
  </article>
</BaseLayout>