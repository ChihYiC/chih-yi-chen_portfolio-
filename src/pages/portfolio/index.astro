---
src/pages/portfolio/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('portfolio');
const base = import.meta.env.BASE_URL; // 取得正確的基礎路徑
---
<BaseLayout title="UX Portfolio | Sophie Chen">
  <div class="mb-12 animate-fade-in animate-duration-500">
    <h1 class="text-4xl font-heading font-bold text-primary mb-4 tracking-tight">UX Portfolio</h1>
    <p class="text-lg text-slate font-body max-w-2xl leading-relaxed">
      Selected UX projects at the intersection of user research, interaction design, and digital experience strategy.
    </p>
  </div>

  {projects.length === 0 ? (
    <div class="bg-white p-12 rounded-2xl border border-slate/10 text-center shadow-sm">
      <p class="text-slate/60 font-body">目前還沒有專案。請到 TinaCMS 後台新增你的第一個 UX Portfolio！</p>
    </div>
  ) : (
    <div class="grid md:grid-cols-2 gap-8">
      {projects.map((project) => (
        // 修正連結路徑：使用 base + 路徑
        <a href={base + `portfolio/${project.id}`} class="group bg-white rounded-2xl shadow-sm border border-slate/5 overflow-hidden hover:-translate-y-1 hover:shadow-md transition-all duration-300 flex flex-col">
          <div class="h-56 bg-accent/30 flex items-center justify-center border-b border-slate/5 overflow-hidden relative">
            {project.data.heroImage ? (
                <img 
                src={base + project.data.heroImage.replace(/^\//, '')} 
                alt={project.data.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                />
                ) : (
                    <span class="text-xs font-mono text-primary/60 tracking-wider">[ Case Study Image ]</span>)}
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h2 class="text-xl font-bold text-primary group-hover:text-secondary transition-colors">{project.data.title}</h2>
              <p class="text-sm text-slate/80 mt-3 leading-relaxed line-clamp-3">{project.data.description}</p>
            </div>
            {project.data.tags && (
              <div class="mt-6 flex flex-wrap gap-2">
                {project.data.tags.map((tag: string) => (
                  <span class="text-[11px] font-medium bg-surface text-slate/70 px-2 py-1 rounded-md border border-slate/10">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  )}
</BaseLayout>