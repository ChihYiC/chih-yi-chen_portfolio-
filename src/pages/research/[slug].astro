---
// src/pages/research/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro'; 
import Callout from '../../components/Callout.astro';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<article class="max-w-3xl mx-auto py-12 px-6">
  <header class="mb-10">
    <div class="mt-4 p-4 bg-slate-100 rounded-lg">
      <span class="font-bold">Methodology:</span> {item.data.methodology}
    </div>
  </header>

  <div class="prose prose-lg max-w-none">
    <Content components={{ Callout }} />
  </div>
</article>
</BaseLayout>