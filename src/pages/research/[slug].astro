---
// src/pages/research/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro'; 
import Callout from '../../components/Callout.astro';
// ✨ 1. 匯入麵包屑元件
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={`${item.data.title} | Research`}>
  <article class="max-w-3xl mx-auto py-12 px-6">
    {/* ✨ 2. 頂部加入麵包屑 */}
    <Breadcrumbs />

    <header class="mb-10 mt-6">
      <h1 class="text-4xl font-bold mb-6 text-primary leading-tight">{item.data.title}</h1>
      
      {/* ✨ 3. 複合資訊欄位（Publication & Methodology） */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 bg-slate-50 rounded-xl border border-slate/5 text-sm">
        {item.data.publication && (
          <div>
            <span class="block font-bold text-slate mb-0.5">Publication Venue:</span>
            <span class="text-slate/70 font-medium">{item.data.publication}</span>
          </div>
        )}
        {item.data.methodology && (
          <div>
            <span class="block font-bold text-slate mb-0.5">Methodology:</span>
            <span class="text-slate/70">{item.data.methodology}</span>
          </div>
        )}
      </div>
    </header>

    <div class="prose prose-lg max-w-none text-slate">
      <Content components={{ Callout }} />
    </div>
  </article>
</BaseLayout>