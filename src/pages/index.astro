---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import avatarImage from '../assets/avatar.png'; 
import { getCollection } from 'astro:content';

const projects = await getCollection('portfolio');
const base = import.meta.env.BASE_URL; // 統一定義 base 路徑，方便後續引用
---

<BaseLayout title="Home | Chih Yi Chen">
  
  <section class="py-16 md:py-24 animate-fade-in">
    <div class="grid md:grid-cols-3 gap-8 md:gap-12 items-center">
      <div class="md:col-span-1 aspect-square w-full overflow-hidden rounded-2xl shadow-md border border-slate/5 bg-white">
        <Image src={avatarImage} alt="Chih Yi Chen Profile" class="w-full h-full object-cover" />
      </div>

      <div class="md:col-span-2 flex flex-col gap-4 text-left">
        <div class="inline-flex items-center gap-2 bg-accent/60 text-primary px-3 py-1 rounded-full text-xs font-heading font-semibold w-fit">
          <span>Integrated Marketer & HCI Researcher</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-primary leading-tight tracking-tight">
          I explore how people perceive, interpret, and interact with digital content.
        </h1>
        <p class="text-lg text-slate leading-relaxed font-body">
          Hi, I’m Chih Yi Chen. My work bridges integrated marketing strategy, UX research, and human-centered AI to understand how digital systems communicate with people.
        </p>
        <div class="flex flex-wrap gap-4 mt-2">
          <a href={base + 'portfolio'} class="bg-primary text-white font-heading font-semibold px-6 py-3 rounded-lg hover:bg-primary/90 transition-all duration-200 shadow-sm">View UX Portfolio</a>
          <a href={base + 'cv'} class="bg-white border border-slate/20 text-slate font-heading font-semibold px-6 py-3 rounded-lg hover:bg-surface transition-all duration-200 shadow-sm">Download CV</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 border-t border-slate/10">
    <h2 class="text-xl font-heading font-bold text-primary mb-6 tracking-tight">
      Latest Updates
    </h2>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate/5 flex flex-col md:flex-row md:items-start justify-between gap-4 border-l-4 border-l-secondary">
      <div class="flex flex-col gap-2">
        <span class="text-[10px] font-bold font-heading uppercase tracking-wider text-secondary bg-secondary/10 px-2.5 py-0.5 rounded-full w-fit">
          Milestone
        </span>
        <h3 class="text-base md:text-lg font-bold text-primary leading-snug">
          Successfully Defended Master’s Thesis！
        </h3>
        <p class="text-sm text-slate/60 leading-relaxed max-w-2xl">
          This research examines how AI disclosure is practiced and made visible in digital marketplaces.
        </p>
      </div>
      <span class="text-sm text-slate/50 font-heading shrink-0">Mar 17, 2026</span>
    </div>
  </section>

  <section class="py-16 border-t border-slate/10 overflow-hidden">
    <div class="flex justify-between items-end mb-8 px-2">
      <div>
        <h2 class="text-2xl font-heading font-bold text-primary tracking-tight">Featured UX Projects</h2>
        <p class="text-sm text-slate/50 mt-1">Scroll to explore my recent work</p>
      </div>
      <a href={base + 'portfolio'} class="text-sm font-semibold text-secondary hover:underline font-heading">View All →</a>
    </div>

    <div class="flex overflow-x-auto gap-6 pb-8 snap-x snap-mandatory no-scrollbar">
      {projects.length === 0 ? (
        <p class="text-slate/40 italic px-2">No projects added yet.</p>
      ) : (
        projects.map((project) => (
          <div class="min-w-[300px] md:min-w-[450px] snap-center">
            <a href={base + `portfolio/${project.slug}`} class="group flex flex-col bg-white rounded-2xl shadow-sm border border-slate/5 overflow-hidden hover:shadow-md transition-all duration-300 h-full">
              <div class="h-48 md:h-64 bg-accent/30 overflow-hidden relative">
                {project.data.heroImage ? (
                  <img src={project.data.heroImage.replace(/^\//, '')} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-primary/30 font-mono text-xs">No Image</div>
                )}
              </div>
              <div class="p-6">
                <h3 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors mb-2">{project.data.title}</h3>
                <p class="text-sm text-slate/70 line-clamp-2 mb-4 leading-relaxed">{project.data.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.data.tags?.slice(0, 2).map((tag: string) => (
                    <span class="text-[10px] bg-surface text-slate/60 px-2 py-0.5 rounded border border-slate/10 font-medium">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </div>
        ))
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>